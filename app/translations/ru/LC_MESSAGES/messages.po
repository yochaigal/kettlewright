#: app/static/json/party_events/bestiary.json:52
msgid ""
"Unharmed by cold, heat, or the elements. Iron weapon damage is enhanced."
msgstr "Неуязвимы для холода, жара и стихий. Урон железным оружием усилен."

#: app/static/json/party_events/bestiary.json:53
msgid "Wail: Anyone in earshot must make a WIL save or fall unconscious."
msgstr ""
"Вой: каждый, кто его слышит, должен сделать спасбросок ВОЛ или потерять "
"сознание."

#: app/static/json/party_events/bestiary.json:57
#: app/static/json/party_events/dungeons.json:258
msgid "Basilisk"
msgstr "Василиск"

#: app/static/json/party_events/bestiary.json:63
#: app/static/json/party_events/bestiary.json:180
