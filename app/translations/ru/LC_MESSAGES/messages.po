msgstr "Банши"

#: app/static/json/party_events/bestiary.json:49
msgid "ghostly touch (d8)"
msgstr "призрачное касание (к8)"

#: app/static/json/party_events/bestiary.json:51
msgid "Incorporeal spirits that linger long after death to haunt the living."
msgstr ""
