msgstr "Отправить код повторно"

#: app/templates/auth/reauthenticate.html:5
msgid "Continue"
msgstr "Продолжить"

#: app/templates/auth/email/mfa.html:1
msgid "Your Kettlewright verification code:"
msgstr "Ваш код подтверждения Kettlewright:"

#: app/templates/auth/email/mfa.html:2
msgid "This code expires in 10 minutes and can only be used once."
msgstr "Код действует 10 минут и может быть использован только один раз."

#: app/templates/auth/email/mfa.html:3
