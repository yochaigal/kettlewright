#: app/templates/main/tools.html
msgid "Results"
msgstr "Resultados"

#: app/templates/main/tools.html
msgid "Pick a table to roll on it. Results appear here."
msgstr "Elige una tabla para tirar en ella. Los resultados aparecen aquí."

#: app/blueprints/party.py
msgid "Roll on the Wilderness Events table afterwards"
msgstr "Tirar en la tabla de Eventos en tierras salvajes después"

#: app/blueprints/party.py
msgid "Each character takes one action per watch: morning, afternoon and night. Results are added to the roll history for the whole party."
msgstr "Cada personaje realiza una acción por guardia: mañana, tarde y noche. Los resultados se añaden al historial de tiradas de todo el grupo."

#: app/blueprints/party.py
msgid "Travel"
msgstr "Viajar"

#: app/blueprints/party.py
msgid "Move along your route; the party may get lost."
msgstr "Avanzad por vuestra ruta; el grupo puede perderse."

#: app/blueprints/party.py
msgid "The party usually travels together. On a Road you cannot get lost; on a Trail you get lost on 1–2 in d6, and in the Wilderness on 1–3."
msgstr "El grupo suele viajar junto. En un Camino no os perdéis; en una Senda os perdéis con 1–2 en d6, y en tierras salvajes con 1–3."

#: app/blueprints/party.py
msgid "Travelling"
msgstr "Viajan"

#: app/blueprints/party.py
msgid "Road"
msgstr "Camino"

#: app/blueprints/party.py
msgid "Trail"
msgstr "Senda"

#: app/blueprints/party.py
msgid "Wilderness"
msgstr "Tierras salvajes"

#: app/blueprints/party.py
msgid "Explore"
msgstr "Explorar"

#: app/blueprints/party.py
msgid "Search the area for hidden places and features."
msgstr "Buscad lugares y rasgos ocultos en la zona."

#: app/blueprints/party.py
msgid "One or more characters search the area, scout ahead or move carefully. This can reveal a location or feature. Leaving the area still takes a Travel action."
msgstr "Uno o más personajes registran la zona, se adelantan a explorar o avanzan con cautela. Puede revelar un lugar o un rasgo. Salir de la zona sigue requiriendo una acción de Viajar."

